{
  "$schema": "../bmc-sdk/bmc-widget-manifest/manifest.schema.json",
  "uid": "e4006019-9b4f-4c83-b93d-71b41357b53c",
  "version": "0.1.0",
  "name": "Deck Calendar",
  "subname": "Your events at a glance",
  "description": "Your Apple, Google or Outlook calendar on the Deck: the month, and what is on today and next",
  "config_help": "Shows your calendars: a month view, and what is on today and next. Tap a day to see its events.\n\n**Connecting a calendar** takes about two minutes:\n\n1. Get the calendar's private link from its service. Pick the service below and the Deck's screen lists the steps until the calendar is connected.\n2. Open **Connected Accounts**, choose **Add New Account**, keep the type **Token**, name it (say \"Apple calendar\") and paste the link as the token. A link that starts with webcal:// must start with https:// instead.\n3. Here, pick the service, then pick that account for **Calendar 1 link**.\n\nThe link works like a password for reading that calendar, which is why it is kept as an account and not in these settings. Calendars 2 and 3 are for more calendars.\n\nThe widget only reads; it can't change your events. It checks for changes every 15 minutes unless you say otherwise, and keeps showing the last events it got when the Deck is offline. Outlook publishes changes to its links only every few hours.",
  "binary": "bin/deck-calendar",
  "icon": "assets/icon.svg",
  "category": "calendar",
  "settings": [
    "timezone"
  ],
  "supported_viewports": [
    {
      "type": "rectangular",
      "min_width": 317,
      "min_height": 238
    }
  ],
  "params": {
    "calendar_1_provider": {
      "name": "Calendar 1 service",
      "description": "Where the first calendar lives",
      "type": "string",
      "default_value": "apple",
      "enum_values": [
        {
          "value": "apple",
          "label": "Apple Calendar (iCloud)"
        },
        {
          "value": "google",
          "label": "Google Calendar"
        },
        {
          "value": "outlook",
          "label": "Outlook (Outlook.com or Microsoft 365)"
        },
        {
          "value": "proton",
          "label": "Proton Calendar"
        },
        {
          "value": "fastmail",
          "label": "Fastmail"
        },
        {
          "value": "nextcloud",
          "label": "Nextcloud"
        },
        {
          "value": "other",
          "label": "Other (any iCalendar link)"
        }
      ],
      "optional": true
    },
    "calendar_1_name": {
      "name": "Calendar 1 name",
